<canvas id="starfield" class="fixed inset-0 z-[2] pointer-events-none"></canvas>

<script>
  interface Star {
    angle: number;
    radius: number;
    r: number;
    baseAlpha: number;
    twinklePhase: number;
    twinkleSpeed: number;
    angularSpeed: number;
  }

  function initStarfield() {
    const canvas = document.getElementById("starfield") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let stars: Star[] = [];
    let rafId = 0;

    function resize() {
      width = canvas!.width = window.innerWidth;
      height = canvas!.height = window.innerHeight;
    }

    // Polar coordinates around the viewport center, like the graph's own
    // slow auto-rotate — the whole field turns together instead of drifting.
    function makeStars() {
      const maxRadius = Math.hypot(width, height) / 2;
      const count = Math.round((width * height) / 3500);
      stars = Array.from({ length: count }, () => ({
        angle: Math.random() * Math.PI * 2,
        radius: Math.random() * maxRadius,
        r: Math.random() * 1.3 + 0.4,
        baseAlpha: Math.random() * 0.4 + 0.25,
        twinklePhase: Math.random() * Math.PI * 2,
        twinkleSpeed: Math.random() * 0.02 + 0.01,
        angularSpeed: 0.0006,
      }));
    }

    let t = 0;
    function tick() {
      t += 1;
      const cx = width / 2;
      const cy = height / 2;
      ctx!.clearRect(0, 0, width, height);
      for (const s of stars) {
        s.angle += s.angularSpeed;
        const x = cx + Math.cos(s.angle) * s.radius;
        const y = cy + Math.sin(s.angle) * s.radius;
        const twinkle = Math.sin(t * s.twinkleSpeed + s.twinklePhase) * 0.25;
        const alpha = Math.max(0, Math.min(1, s.baseAlpha + twinkle));
        ctx!.beginPath();
        ctx!.arc(x, y, s.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255,255,255,${alpha})`;
        ctx!.fill();
      }
      rafId = requestAnimationFrame(tick);
    }

    function start() {
      cancelAnimationFrame(rafId);
      resize();
      makeStars();
      tick();
    }

    start();
    window.addEventListener("resize", start);
  }

  // Module scripts run deferred, after the DOM (including the <canvas> above)
  // is already parsed, so DOMContentLoaded may have already fired by the time
  // this executes — waiting for it here means the listener can be attached
  // too late and never run. Call directly instead.
  initStarfield();
</script>
